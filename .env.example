# AutivaShop Backend Phase 01 — safe configuration template.
# Copy to .env for reference only; the application reads PROCESS environment variables.
# Never commit a real .env file, password, or connection string.

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
LOG_LEVEL=info
MIGRATIONS_DIR=migrations

# PostgreSQL. DATABASE_URL wins when present.
# In production DATABASE_URL is REQUIRED and sslmode=disable is REJECTED.
# Replace CHANGE_ME with a local, non-production placeholder before use.
DATABASE_URL=postgres://autivashop_app:%40Ma0780285096@127.0.0.1:5432/autivashop_dev?sslmode=disable
TEST_DATABASE_URL=postgres://autivashop_app:%40Ma0780285096@127.0.0.1:5432/autivashop_test?sslmode=disable

# Alternative discrete database settings (used only when DATABASE_URL is empty).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=autivashop_app
DB_PASSWORD=%40Ma0780285096
DB_NAME=autivashop_dev
DB_SSLMODE=disable

# Connection pool
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=10m
DB_HEALTH_CHECK_PERIOD=1m

# Frontend origins allowed by CORS (exact scheme://host[:port]; no wildcard).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# Limits and timeouts
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT=10s
DB_QUERY_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
READ_HEADER_TIMEOUT=5s
WRITE_TIMEOUT=10s

# Admin authentication and sessions (Phase 02)
AUTH_SESSION_TTL=8h
AUTH_SESSION_COOKIE_NAME=autiva_admin_session
AUTH_CSRF_COOKIE_NAME=autiva_admin_csrf
AUTH_COOKIE_DOMAIN=
# In production this must be true; in development/test it may be false for http://localhost.
AUTH_COOKIE_SECURE=false
# lax|strict|none (none requires secure cookies)
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_LOGIN_RATE_LIMIT_PER_MIN=10
AUTH_LOGIN_RATE_LIMIT_BURST=5
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_LOCKOUT_WINDOW=15m

# Customer accounts and private sessions (Phase 06).
# These cookie names must differ from each other and from all admin cookie names.
CUSTOMER_SESSION_TTL=8h
CUSTOMER_SESSION_COOKIE_NAME=autiva_customer_session
CUSTOMER_CSRF_COOKIE_NAME=autiva_customer_csrf

# Authoritative orders. Reservations expire without deducting payment.
ORDER_RESERVATION_TTL=30m

# Payments (Phase 08). Only local simulation exists in this backend phase.
# mock is permitted ONLY when APP_ENV=development or test.
# Production fails closed: no provider value can enable mock or the unimplemented
# live provider. xendlypay is a typed future boundary in development/test and
# never performs a network call or returns a simulated success.
PAYMENT_PROVIDER=mock

# One-time administrator bootstrap (CLI only). Keep false unless explicitly performing bootstrap.
AUTIVASHOP_ALLOW_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_DISPLAY_NAME=AutivaShop Administrator
# BOOTSTRAP_ADMIN_ROLE=super_admin
# BOOTSTRAP_ADMIN_PASSWORD must be supplied securely at runtime (env or stdin); never commit it.
# Development-only private product image directory (never a public static root).
# Production uploads stay unavailable until a durable object storage adapter is configured.
PRODUCT_IMAGE_DIR=var/product-images
